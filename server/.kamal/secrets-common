# Secrets for every destination, read by Kamal for registry/password, env/secret
# and accessories/*/env/secret in config/deploy*.yml. This file holds names only
# and is safe for git: the values come from the environment, which
# config/deploy.yml fills from the repository root's .env.<destination> (or
# VANAI_ENV_FILE) before Kamal reads this. See .env.production.example.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Optional: empty leaves the AI courts dormant (COURTS.md "Dormant courts").
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# Optional: empty sends no error reports to Good Sorcery (DEPLOY.md "Settings and secrets").
GOODSORCERY_API_KEY=$GOODSORCERY_API_KEY

# Only with VANAI_HTTPS=tunnel (config/deploy.yml).
TUNNEL_TOKEN=$TUNNEL_TOKEN
