# Production settings and secrets for `bin/kamal ... -d production`.
#
# Copy to .env.production here at the repository root (gitignored, and outside the
# Docker build context) and fill it in. server/config/deploy.yml loads it before
# anything else, so every value below reaches the deploy config and
# server/.kamal/secrets-common. To keep it outside the checkout -- a clean
# worktree has no ignored files -- point VANAI_ENV_FILE at it instead:
#
#   VANAI_ENV_FILE=~/.config/vanai/production.env bin/kamal deploy -d production
#
# Another destination reads its own file the same way: -d staging, .env.staging.
#
# Anything already set in your shell wins over this file, so CI can export the
# same names instead. A value can be a command, run at deploy time, which keeps
# the secret itself in a password manager or the macOS keychain:
#
#   POSTGRES_PASSWORD=$(security find-generic-password -a "$USER" -s vanai-postgres -w)
#   POSTGRES_PASSWORD=$(bw get password "Vanai Postgres")

# --- The host -------------------------------------------------------------------

# The server's address. Web, Sidekiq and every accessory run on this one box
# (DEPLOY.md "The one architectural rule").
VANAI_HOST=203.0.113.10

# SSH user and port Kamal connects with. The host needs only that user, reachable
# with your SSH key, and Docker installed; provision it however you like. A stock
# VPS is root on 22. A user other than root needs to be in the docker group.
VANAI_SSH_USER=root
VANAI_SSH_PORT=22

# The public hostname players load the game from. kamal-proxy routes it to the
# app and APP_ORIGIN (the Action Cable allowlist) is derived from it.
VANAI_DOMAIN=play.example.com

# How players reach it over HTTPS, one of:
#   letsencrypt  kamal-proxy gets a certificate itself. VANAI_DOMAIN's DNS must
#                point at VANAI_HOST and ports 80 and 443 must be open.
#   tunnel       a Cloudflare tunnel fronts the app (TUNNEL_TOKEN, below): no open
#                web ports, and the host's address stays out of DNS. Point the
#                tunnel's public hostname at http://kamal-proxy:80 in the
#                Cloudflare dashboard.
VANAI_HTTPS=letsencrypt

# Where the client fetches the maker's assets (ASSETS.md, DEPLOY.md "The maker's
# assets"). Baked into the client bundle at build time, so it is public. Either a
# bucket or CDN URL, or /runtime to serve them from this server: then the files
# live in VANAI_RUNTIME_DIR on the host (default /var/lib/vanai/runtime).
VANAI_ASSET_BASE=https://assets.example.com
# VANAI_RUNTIME_DIR=/var/lib/vanai/runtime

# --- The image registry ---------------------------------------------------------

KAMAL_REGISTRY_SERVER=ghcr.io
KAMAL_REGISTRY_USER=your-github-user
KAMAL_IMAGE=your-github-user/vanai

# --- Secrets --------------------------------------------------------------------

# A registry token with push access (GitHub: a classic PAT with write:packages).
KAMAL_REGISTRY_PASSWORD=

# Signs sessions and cookies. Generate one with `bin/rails secret`; changing it
# signs every player out.
SECRET_KEY_BASE=

# The Postgres accessory's password. Fixed at the first `kamal setup`: the
# database keeps the one it was created with.
POSTGRES_PASSWORD=

# Optional: the AI courts (COURTS.md "Dormant courts"). Empty, they are dormant.
ANTHROPIC_API_KEY=

# Only with VANAI_HTTPS=tunnel: the Cloudflare tunnel's token.
TUNNEL_TOKEN=
