  "interactables": [
    {
      "id": "writ_mausoleum",
      "name": "The Sealed Notice",
      "x": 64,
      "z": 130.4,
      "idle_msg": "The Emperors' Vault, under the dome at the Mausoleum's heart. On the empty bier where an emperor would lie, a notice under wax: the Sealed Notice, the founding writ of the Hunting Wood. Through the wax you can read it: The household departs this night and will return. Keep out. Keep well.",
      "active_msg": "You break the seal and lift the writ. The household departs this night and will return. Keep out. Keep well. One line, in a steady hand, and nothing else. The writ is yours, and the province's founding terms with it; take its words back to Scout Bettany at Caerdun's Forward Camp.",
      "prop": "dais_notice",
      "y": 1.2,
      "table_height": 1.5,
      "site": "raised_chamber",
      "floor": 1
    },
    {
      "id": "ms_visitors_register",
      "name": "The Visitors' Register",
      "x": 8,
      "z": -107,
      "y": 0,
      "prop": "existing_table",
      "table_height": 1.2,
      "idle_msg": "Fresh ink waits beside a register open at its last entry. The date is almost three centuries old. The visitor signed only: sorry. Below it, the next line has been ruled with care.",
      "active_msg": "Fresh ink waits beside the visitors' register. The next line is still blank."
    },
    {
      "id": "ms_unfinished_ledger",
      "name": "The Unfinished Ledger",
      "x": 108,
      "z": 32,
      "y": 0,
      "prop": "existing_table",
      "table_height": 1.1,
      "idle_msg": "Lamp oil received. Linen washed. The names read at dusk. The same entries, year after year. The final column — Household returned — remains empty.",
      "active_msg": "The household has not returned. The lamps have never gone out."
    }
  ],
