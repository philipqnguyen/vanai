  "interactables": [
    {
      "id": "wax_cabinet",
      "name": "The Wax-Sealed Cabinet",
      "x": 4,
      "z": 6,
      "idle_msg": "A cabinet in the bell chamber, sealed with wax before the valley was flooded; whatever is inside was meant to be found dry, by someone, someday. Through the wax you can make out one page lying in it, and a bundle of rolled papers beside it.",
      "active_msg": "You break the wax and lift the page out. One line, written the night before the vanishing in a hand so calm it is almost rude: 'Seal it behind us.' Beside it lie the striking rolls, the bell's peal written out year by year; the gaps between the strokes grow shorter every year, closing on one date.",
      "prop": "cabinet",
      "y": 32,
      "site": "raised_chamber",
      "floor": 5
    },
    {
      "id": "striking_rolls",
      "name": "The Striking Rolls",
      "x": -4,
      "z": 6,
      "idle_msg": "The bell's record, roll on roll. It is not a bell. It is a clock face the size of a valley, and it is counting down.",
      "active_msg": "You take the striking rolls. Every court will want them; every court will read the same date.",
      "prop": "document_table",
      "y": 32,
      "site": "raised_chamber",
      "floor": 5
    }
