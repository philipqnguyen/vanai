  "npcs": [
    {
      "id": "gate_sergeant_ottey",
      "name": "Gate-Sergeant Ottey",
      "kind": "quest",
      "title": "The Drill Yards",
      "dialog": [
        "Up here we don't ask why we keep the watch. The empire locked its door and left us on the step like a delivery nobody signed for. Fine. We're Caerdun. We signed for ourselves.",
        "The wall's been walked every night for three hundred years and it will not stop being walked because my knees have opinions.",
        "Harbour, lighthouse, ramparts, crown. Learn the city; the city is the route."
      ]
    },
    {
      "id": "paymaster_vail",
      "name": "Paymaster Vail",
      "kind": "quest",
      "title": "The Wage Vaults",
      "dialog": [
        "Nine generations of my family have kept this room. Every night of watch stood on that wall since the Sealing, written down, valued, and owed.",
        "The empire left without paying its garrison. So we kept the invoice.",
        "Touch nothing else; the vault notices."
      ],
      "site": "court_archive",
      "floor": 0
    },
    {
      "id": "marshal_grett",
      "name": "Marshal Grett",
      "kind": "quest",
      "title": "The Drill Yards",
      "dialog": [
        "FORMS! Wall-form third! Your grandmothers held this line with worse knees and better attitudes!",
        "Our oath isn't fight. Our oath is hold until relieved. Nobody relieved us. So we hold.",
        "I don't break oaths for civilians. So: stop being one."
      ]
    },
    {
      "id": "duelist_sabel_cd",
      "name": "Duelist-Master Sabel",
      "kind": "quest",
      "title": "The Drill Yards",
      "dialog": [
        "First blood, all grievances discharged, drinks after. It's civilised, it's legal, and it keeps the lawyers poor, which I consider a public service.",
        "People don't fight over old paper. They fight over paper that frightens them.",
        "Composure is half of duelling and all of being a second. Practise on the walk."
      ]
    },
    {
      "id": "lord_marshal",
      "name": "The Lord Marshal",
      "kind": "quest",
      "title": "The Parade Square",
      "dialog": [
        "Once as a soldier, once as a ruler, once as a man whose grandfather died on that wall. It reads differently each time and it never reads well.",
        "Three cities, three pieces, three centuries of not comparing notes. That ends now.",
        "If the empire truly means to settle its debts, what happens next is the largest transaction in the history of the world."
      ]
    },
    {
      "id": "armourer_brann",
      "name": "Armourer Brann",
      "kind": "vendor",
      "title": "The Market Crossroads",
      "stock": [
        "worn_sword",
        "worn_katana",
        "worn_greatsword",
        "ash_staff",
