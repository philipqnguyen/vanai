    },
    "lines": [
     {
      "at": 1.2,
      "dur": 9.4,
      "text": "The Bell Tower of the drowned valley. Everyone in the three cities grew up on the story of the bell that rings over the water for nobody."
     }
    ]
   },
   {
    "dur": 11.2,
    "cam": {
     "from": {
      "pos": [
       8.5,
       1.8,
       -2
