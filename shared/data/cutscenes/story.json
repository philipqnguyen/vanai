    "lines": [
     {
      "at": 0.8,
      "dur": 8.1,
      "text": "The rolls lie open on the table, and the last entries are fresh, in the same calm hand that wrote 'Seal it behind us'."
     }
    ]
   },
   {
    "dur": 12.2,
    "cam": {
