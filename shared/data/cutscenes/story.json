    "lines": [
     {
      "at": 0.6,
      "dur": 5.3,
      "who": "npc:sabel_census",
      "text": "You're in here, {name}. So am I. Emmer is. So is everyone we've ever buried."
     },
     {
      "at": 6.1,
      "dur": 8.3,
      "who": "npc:sabel_census",
      "text": "We were never outside the empire. The sentinels' household is us too. We were the part of the household that stayed home."
     }
    ]
   },
