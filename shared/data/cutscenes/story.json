    "lines": [
     {
      "at": 0.6,
      "dur": 11.5,
      "who": "npc:sabel_census",
      "text": "The rolls are current, and they're not theirs. They're ours. Caerdun, Heartwood, Moonmere: births, deaths and marriages, three hundred years of us, kept up to this year."
     }
    ]
   },
   {
    "dur": 14.5,
