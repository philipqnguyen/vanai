      "fov": 0.6
     }
    },
    "lines": [
     {
      "at": 0.6,
      "dur": 6.9,
      "who": "npc:sabel_gates",
      "text": "Then we write it an honest one. That's what an audit is. Sleep, all of you; we go in at first light."
